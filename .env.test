# ─── Test Environment ────────────────────────────────────────────────────────
# Used by Vitest unit tests and Playwright e2e tests

# Database — separate SQLite file for testing (reset between test runs)
DATABASE_URL=file:./db/test.db

# Authentication
AUTH_SECRET=test-secret-for-vitest
NEXTAUTH_SECRET=test-secret-for-vitest
NEXTAUTH_URL=http://localhost:3000

# Node environment
NODE_ENV=test

# ─── Database ────────────────────────────────────────────────────────────────
# Local development (SQLite):
DATABASE_URL=file:./db/custom.db
# Docker/Production (PostgreSQL):
# DATABASE_URL=postgresql://accessmap:YOUR_DB_PASSWORD@db:5432/accessmap

# ─── Authentication (Auth.js v5) ─────────────────────────────────────────────
# Required: Generate with `openssl rand -base64 32`
AUTH_SECRET=change-me-to-a-secure-random-string

# ─── Admin Seed (used only by prisma/seed.ts) ───────────────────────────────
# ADMIN_EMAIL=admin@accessmap.eg
# ADMIN_PASSWORD=your-secure-admin-password

# ─── Auth URL (production only) ──────────────────────────────────────────────
# AUTH_URL=https://your-domain.com
